From 0a10c5a25fe0a0b9746682f0d482b6db7fdfb309 Mon Sep 17 00:00:00 2001
From: Hecheng Yu <kde-yyds@qq.com>
Date: Tue, 21 Jul 2026 20:32:02 -0700
Subject: [PATCH] Enable Live Photo

---

diff --git a/smali/com/oplus/aiunit/vision/g19.smali b/smali/com/oplus/aiunit/vision/g19.smali
--- a/smali/com/oplus/aiunit/vision/g19.smali
+++ b/smali/com/oplus/aiunit/vision/g19.smali
@@ -197,6 +197,47 @@
     .annotation runtime Lkotlin/jvm/JvmStatic;
     .end annotation
 
+    const-string v0, "feature_is_support_olive"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v1
+
+    if-nez v1, :cond_olive_enabled
+
+    const-string v0, "feature_is_support_olive_slide_play"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v1
+
+    if-nez v1, :cond_olive_enabled
+
+    const-string v0, "feature_is_support_video_extract_olive"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v1
+
+    if-nez v1, :cond_olive_enabled
+
+    const-string v0, "feature_olive_slow_motion_recommend_popup_shown"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v1
+
+    if-nez v1, :cond_olive_enabled
+
+    goto :goto_olive_check_done
+
+    :cond_olive_enabled
+    const/4 v0, 0x1
+
+    return v0
+
+    :goto_olive_check_done
+
     .line 1
     const-string v0, "configId"
 
